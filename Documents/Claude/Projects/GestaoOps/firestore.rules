rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ───────────────────────────────────────────────────────────────
    // Bloqueia TODO acesso não autenticado (antes era aberto à internet).
    //
    // Limitação conhecida: o login de gestor via RemateWeb usa auth
    // anônimo do Firebase, então as regras não conseguem distinguir
    // papel (role) no servidor para esse fluxo. A separação fina por
    // papel exige migrar o login para Custom Tokens emitidos por um
    // backend (Cloud Function) — ver TODO abaixo.
    // ───────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // Perfil de login: cada usuário lê apenas o próprio documento.
    // Bloqueio principal: ninguém altera o PRÓPRIO role (anti auto-promoção).
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      // Atualização: gestão atualiza docs de terceiros; o próprio usuário
      // só altera campos que não incluam 'role' (ex: mustResetPassword).
      allow update: if isSignedIn() && (
        request.auth.uid != uid ||
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
      );
      // Criação: apenas para outros uids (fluxo de cadastro de operador).
      // Impede criar o próprio doc com role arbitrário.
      allow create: if isSignedIn() && request.auth.uid != uid;
      allow delete: if isSignedIn() && request.auth.uid != uid;
    }

    // Coleções operacionais: exigem autenticação.
    // TODO(segurança): quando o login de gestor migrar para Custom Token
    // com claim de role, restringir:
    //   - operators (paymentRules/salários): leitura só gestão ou o próprio
    //   - events.revenue/expenses: leitura só gestão
    match /operators/{doc} {
      allow read, write: if isSignedIn();
    }
    match /events/{doc} {
      allow read, write: if isSignedIn();
    }
    match /settings/{doc} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /holidays/{doc} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    // Rótulos manuais de atividade na Modelo de Escala (operador × dia).
    match /scheduleNotes/{doc} {
      allow read, write: if isSignedIn();
    }
    // Rascunhos de notificações (envio à API RemateWeb é fase futura).
    match /notifications/{doc} {
      allow read, write: if isSignedIn();
    }
    // Turnos de operador de painel (Modelo de Escala).
    match /panelShifts/{doc} {
      allow read, write: if isSignedIn();
    }
    // Preferência de layout da home — cada usuário só lê/escreve a própria.
    match /userDashboards/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
    // Log de auditoria — qualquer autenticado escreve; leitura por todos autenticados
    // (a UI restringe a admin via route guard; regras de role em cloud functions são futuro).
    match /auditLog/{doc} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update, delete: if false;
    }

    // Qualquer outra coleção: negada por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
