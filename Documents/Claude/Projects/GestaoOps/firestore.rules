rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ───────────────────────────────────────────────────────────────
    // Segurança baseada em role: usa get() para ler o perfil do usuário.
    // A chamada get() é cacheada por request — não dobra as leituras.
    // ───────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // Lê o role do usuário logado. Retorna null se o doc ainda não existe
    // (primeiro login — evita negar acesso em race condition).
    function userRole() {
      let uid = request.auth.uid;
      return exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data.role
        : null;
    }

    function hasRole(roles) {
      return isSignedIn() && userRole() in roles;
    }

    // Gestão: qualquer papel não-operador.
    function isManagement() {
      return hasRole(['admin', 'ceo', 'gestor', 'financeiro', 'comercial', 'administrativo', 'planejamento']);
    }

    // Admin exclusivo (configurações, auditoria).
    function isAdmin() {
      return hasRole(['admin']);
    }

    // Quem pode escrever eventos: gestão + operador de painel (não freelancers).
    function canWriteEvent() {
      return hasRole(['admin', 'ceo', 'gestor', 'operador_painel', 'comercial', 'administrativo', 'planejamento']);
    }

    // Quem pode escrever dados de operadores.
    function canWriteOperator() {
      return hasRole(['admin', 'ceo', 'gestor', 'administrativo']);
    }

    // Quem pode escrever configurações.
    function canWriteSettings() {
      return hasRole(['admin', 'ceo', 'gestor', 'administrativo']);
    }

    // Perfil do usuário.
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && (
        request.auth.uid != uid ||
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
      );
      allow create: if isSignedIn() && request.auth.uid != uid;
      allow delete: if isSignedIn() && request.auth.uid != uid;
    }

    // Operadores: todos os autenticados leem (dados básicos de equipe, sem financeiro).
    // Escrita restrita a admin/gestor/administrativo.
    match /operators/{doc} {
      allow read: if isSignedIn();
      allow write: if canWriteOperator();
    }

    // Eventos: todos autenticados leem; freelancers não escrevem.
    match /events/{doc} {
      allow read: if isSignedIn();
      allow write: if canWriteEvent();
    }

    // Configurações: todos leem; só gestão escreve.
    match /settings/{doc} {
      allow read: if isSignedIn();
      allow write: if canWriteSettings();
    }

    match /holidays/{doc} {
      allow read: if isSignedIn();
      allow write: if canWriteSettings();
    }

    // Rótulos manuais de escala (operador × dia).
    match /scheduleNotes/{doc} {
      allow read, write: if isSignedIn();
    }

    // Notificações.
    match /notifications/{doc} {
      allow read, write: if isSignedIn();
    }

    // Turnos de operador de painel.
    match /panelShifts/{doc} {
      allow read: if isSignedIn();
      allow write: if hasRole(['admin', 'ceo', 'gestor', 'operador_painel', 'administrativo']);
    }

    // Preferência de layout da home — cada usuário só lê/escreve a própria.
    match /userDashboards/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Log de auditoria — imutável: create para todos os autenticados; leitura só admin.
    match /auditLog/{doc} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Disponibilidade / blockouts de operadores.
    match /operatorBlockouts/{doc} {
      // Gestão lê tudo; operador lê apenas as próprias solicitações.
      allow read: if isManagement() || (isSignedIn() && resource.data.userId == request.auth.uid);
      // Criação: qualquer autenticado, desde que seja o próprio userId.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Gestor aprova/recusa; operador pode cancelar a própria.
      allow update: if isManagement() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Qualquer outra coleção: negada por padrão (default-deny).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
